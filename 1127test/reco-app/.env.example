# 키 이름만 커밋한다. 값은 각자 .env.local(커밋 금지)과 Vercel Project Settings에 같은 이름으로 넣는다.
# 브라우저에 들어가도 되는 값 (NEXT_PUBLIC_ = 빌드 때 브라우저 코드에 포함)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 — app/api/ 서버 함수에서만 사용
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
# 선택: 비우면 gemini-flash-latest
GEMINI_MODEL=
