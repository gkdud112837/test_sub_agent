# ── Gemini ───────────────────────────────────────
# Google AI Studio에서 발급한 키를 넣는다. 비워 두면 dry-run(가짜 응답)만 돌릴 수 있다.
GEMINI_API_KEY=
MODEL_NAME=gemini-3.8-flash
TEMPERATURE=0.3

# ── 실행 ─────────────────────────────────────────
# 분석 에이전트가 Google 검색으로 최신 자료를 모을지 (true/false)
USE_SEARCH=true
# 같은 경로(R1~R4)로 되돌아가는 최대 횟수
MAX_REWORK=2
# 동시에 보내는 LLM 요청 수 상한
MAX_CONCURRENCY=6

# ── 파일 (1123test 기준 상대경로) ─────────────────
REFERENCE_PDF=IT하드웨어_SK증권_산업리포트.pdf
BRIEF_PATH=data/brief.md
CONFIG_DIR=config
WORKSPACE_DIR=workspace
DRY_RUN_FIXTURE=fixtures/dry_run.json

# ── 웹 (로컬 전용: 127.0.0.1 또는 localhost만 허용) ─
WEB_HOST=127.0.0.1
WEB_PORT=8770
