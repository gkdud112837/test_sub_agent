{
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "route": {
            "type": "string",
            "enum": [
              "R1",
              "R2",
              "R3"
            ]
          },
          "target": {
            "type": "string",
            "enum": "$REVIEW_TARGETS"
          },
          "location": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "fix_hint": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "minor"
            ]
          }
        },
        "required": [
          "route",
          "target",
          "location",
          "problem",
          "fix_hint",
          "severity"
        ]
      }
    },
    "log_summary": {
      "type": "string"
    }
  },
  "required": [
    "verdict",
    "issues",
    "log_summary"
  ]
}
